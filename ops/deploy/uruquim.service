# Uruquim — canonical systemd unit (item 1a).
#
# A faulting handler ABORTS the process — Odin has no recoverable panic (ADR-020),
# so a nil dereference, a failed assertion or an out-of-bounds index in your
# handler ends the program. The supervisor restarting it IS the recovery
# mechanism; there is no other one. This unit is that supervisor, and it also
# encodes the rest of the mandatory topology the readiness matrix
# (planning/closure-readiness-matrix.md) delegates to the platform: total memory
# to a cgroup, restart to the supervisor, and the io_uring locked-memory limit
# that a resource-starved start needs.
#
# Copy to /etc/systemd/system/uruquim.service, edit the three marked values, then:
#   systemctl daemon-reload && systemctl enable --now uruquim
#
# Diagnosing a fault: with systemd-coredump installed, `coredumpctl gdb uruquim`
# opens the core of the crash with the faulting handler on the stack — which
# request killed the process, named precisely. See docs/operations.md §"Diagnosing
# a handler fault". This is why the core installs NO crash signal handler of its
# own (ADR-047): the coredump is safer and more informative than a breadcrumb.

[Unit]
Description=Uruquim HTTP service
After=network-online.target
Wants=network-online.target

[Service]
# --- EDIT THESE THREE (systemd has NO trailing-comment syntax; keep values clean) ---
# ExecStart: your compiled binary.
ExecStart=/usr/local/bin/your-app
# User: a dedicated unprivileged user.
User=uruquim
# MemoryMax: the C-04 cgroup bound. Size it by the rule below.
MemoryMax=1G

# Restart on fault. A faulting handler exits non-zero; on-failure restarts it and
# leaves a clean `systemctl stop` alone. RestartSec keeps a crash-loop from
# spinning the CPU.
Restart=on-failure
RestartSec=1

# The shutdown outer bound. It MUST be longer than web.Limits.max_drain_time
# (default 10s) — the drain deadline is only real if it expires before the kill —
# and shorter than your orchestrator's grace period. web.serve returns when the
# drain finishes; if a blocked handler outlasts the drain, this kill is the bound.
TimeoutStopSec=30

# io_uring pins memory against RLIMIT_MEMLOCK: one event loop is set up per
# Handler lane per server. A too-low limit makes serve fail to acquire its loop
# (F-C03-2) — now a clean, restartable serve failure rather than a crash, but a
# failure nonetheless. Give it real headroom; 64M is ample for the default lane
# counts. Raise it if you raise max_handlers a lot.
LimitMEMLOCK=67108864

# MemoryMax is the AGGREGATE memory guard the matrix delegates here. Size it by
# the C-04 rule (docs/operations.md): with web.Limits.max_response_bytes set, it
# is max_connections × max_response_bytes + baseline; unset, it is
# max_connections × (largest response your handlers build). Prefer setting
# max_response_bytes so this number is one you control. Exceeding MemoryMax is an
# OOM kill — which Restart=on-failure then recovers.

# Hardening: least privilege, so a compromised handler has the smallest blast
# radius. Drop or relax these only where your app genuinely needs the access.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# If your app writes files (e.g. the upload spool dir), list them here:
# ReadWritePaths=/var/lib/your-app

[Install]
WantedBy=multi-user.target
