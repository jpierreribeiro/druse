# R1 controlled-pilot policy. This is a shell/systemd-compatible KEY=value
# file: no command substitutions, quoting tricks or inherited defaults.
DRUSE_PILOT_PROFILE=r1-controlled-pilot
DRUSE_PILOT_OWNER=jpierreribeiro
DRUSE_PILOT_WINDOW_MINUTES=60
DRUSE_PILOT_MAX_RPS=10
DRUSE_PILOT_MAX_CONCURRENCY=20
DRUSE_PILOT_MAX_STREAMS=2
DRUSE_PILOT_MAX_UPLOADS=1
DRUSE_PILOT_ALLOWED_PATH_PREFIX=/pilot/
DRUSE_PILOT_HEALTH_PATH=/health
DRUSE_PILOT_READINESS_PATH=/ready
DRUSE_PILOT_DATA_CLASS=synthetic-or-reconstructible
DRUSE_PILOT_MAX_5XX_PERCENT=1
DRUSE_PILOT_MAX_P99_MS=500
DRUSE_PILOT_MAX_MEMORY_PERCENT=80
DRUSE_PILOT_MAX_READINESS_FAILURES=2
DRUSE_PILOT_MAX_SATURATION_EVENTS=0
DRUSE_PILOT_ROLLBACK_MINUTES=5
